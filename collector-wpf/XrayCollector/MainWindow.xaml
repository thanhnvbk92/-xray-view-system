<Window x:Class="XrayCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:XrayCollector.ViewModels"
        xmlns:views="clr-namespace:XrayCollector.Views"
        mc:Ignorable="d"
        Title="X-Ray Collector System" Height="720" Width="500"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="#F0F2F5"
        FontFamily="Segoe UI, Roboto, Helvetica, Arial, sans-serif">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <materialDesign:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="25,20" materialDesign:ElevationAssist.Elevation="Dp3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="X-RAY COLLECTOR" 
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                               Foreground="White" 
                               FontWeight="Black"/>
                    <TextBlock Text="{Binding Home.Version}" 
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                               Foreground="White" 
                               Opacity="0.8"
                               Margin="2,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="CẬP NHẬT"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Background="White"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            FontWeight="Bold"
                            Padding="16,4"
                            Height="34"
                            materialDesign:ButtonAssist.CornerRadius="17"
                            Visibility="{Binding Home.IsUpdateAvailable, Converter={StaticResource BoolVisConverter}}"
                            Command="{Binding Home.PerformUpdateCommand}"
                            Margin="0,0,8,0"/>

                    <materialDesign:PopupBox Foreground="White"
                                            PlacementMode="BottomAndAlignRightEdges">
                        <StackPanel Width="200">
                            <Button Command="{Binding Home.CheckForUpdatesCommand}" 
                                    Content="Kiểm tra phiên bản mới"
                                    Margin="8"/>
                            <Separator/>
                            <Button Content="Giới thiệu" IsEnabled="False" Margin="8"/>
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Tab Navigation - Now hosting UserControls -->
        <TabControl Grid.Row="1" 
                    SelectedIndex="0"
                    Style="{StaticResource MaterialDesignTabControl}" 
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">

            <!-- OPERATION TAB -->
            <TabItem Header="HOME">
                <views:HomeView DataContext="{Binding Home}"/>
            </TabItem>

            <!-- SETTINGS TAB -->
            <TabItem Header="CÀI ĐẶT">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <!-- Update Progress Overlay -->
        <Grid Grid.RowSpan="2" Background="#80000000" 
              Visibility="{Binding Home.IsUpdating, Converter={StaticResource BoolVisConverter}}"
              Panel.ZIndex="999">
            <materialDesign:Card Width="350" Padding="30" UniformCornerRadius="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ĐANG TẢI BẢN CẬP NHẬT" 
                             Style="{StaticResource MaterialDesignHeadline6TextBlock}" 
                             HorizontalAlignment="Center" 
                             FontWeight="Bold" 
                             Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Vui lòng chờ trong giây lát..." 
                             Style="{StaticResource MaterialDesignBody2TextBlock}" 
                             Opacity="0.7" 
                             HorizontalAlignment="Center" 
                             Margin="0,0,0,25"/>

                    <ProgressBar Value="{Binding Home.UpdateProgress}" 
                                Minimum="0" Maximum="100" 
                                Height="10"
                                Margin="0,5"/>

                    <TextBlock Text="{Binding Home.UpdateProgress, StringFormat={}{0:0}%}" 
                             HorizontalAlignment="Right" 
                             Margin="0,4,0,0" 
                             FontWeight="Bold" 
                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
