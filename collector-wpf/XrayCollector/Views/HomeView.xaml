<UserControl x:Class="XrayCollector.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XrayCollector.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
        <!-- Lưu ý: Converter này được định nghĩa ở Window, nhưng nếu dùng trong UserControl thì nên khai báo lại hoặc dùng chung từ App.xaml -->
    </UserControl.Resources>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Machine Info Badge Card -->
        <materialDesign:Card Padding="24" Margin="0,0,0,25" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ĐANG GIÁM SÁT" Style="{StaticResource MaterialDesignOverlineTextBlock}" Opacity="0.5" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CurrentLineName}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding CurrentMachineName}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" FontWeight="Medium" Opacity="0.7"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" VerticalAlignment="Top" Padding="12,6" CornerRadius="12" Background="{Binding StatusColor}" Opacity="0.15">
                        <TextBlock Text="ACTIVE" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
                
                <Separator Margin="0,20" Opacity="0.1"/>
                
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KẾT NỐI SERVER" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.5" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MaterialDesignBody1TextBlock}" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right"
                            Content="{Binding MonitoringButtonText}"
                            Style="{StaticResource StatusButtonStyle}"
                            Width="180"
                            Command="{Binding ToggleMonitoringCommand}"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <TextBlock Grid.Row="1" Text="HOẠT ĐỘNG GẦN ĐÂY" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" FontWeight="Bold" Margin="4,0,0,12" Opacity="0.7"/>
        <materialDesign:Card Grid.Row="2" Padding="12" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp1">
            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F0F2F5" BorderThickness="0,0,0,1" Padding="8,10">
                            <TextBlock Text="{Binding}" Style="{StaticResource MaterialDesignBody2TextBlock}" Opacity="0.8"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </materialDesign:Card>
    </Grid>
</UserControl>
