<UserControl x:Class="XrayCollector.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XrayCollector.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    
    <Grid Margin="16,4,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cards Stack -->
            <RowDefinition Height="*"/>    <!-- Log Stream -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Machine Info & Start/Stop Row -->
            <materialDesign:Card Padding="16" UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center">
                        <!-- Line Name -->
                        <TextBlock Text="{Binding CurrentLineName}" FontSize="10" FontWeight="Black" Foreground="#2563EB" Margin="0,0,0,2"/>
                        <!-- Machine Name -->
                        <TextBlock Text="{Binding CurrentMachineName}" FontSize="18" FontWeight="Black" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                        <!-- Machine Type & IP -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding MachineTypeName}" FontSize="10" FontWeight="Medium" Foreground="#64748B"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#CBD5E1" Margin="4,0"/>
                            <TextBlock Text="IP: " FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LocalIpAddress}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Monitoring Control -->
                    <Button Grid.Column="1" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Command="{Binding ToggleMonitoringCommand}"
                            Background="{Binding StatusColor}"
                            Foreground="White"
                            Height="50" Width="140"
                            materialDesign:ButtonAssist.CornerRadius="12"
                            materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding MonitoringButtonIcon}" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MonitoringButtonText}" Margin="10,0,0,0" FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>
        </StackPanel>


        <!-- Log Terminal Section (Professional Light-Dark) -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="16" Padding="1" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#334155" CornerRadius="15,15,0,0" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                             <materialDesign:PackIcon Kind="Console" Foreground="#60A5FA" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="LOG" FontWeight="Black" FontSize="9" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" FontSize="8" FontWeight="Black" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Border Background="#10B981" Width="6" Height="6" CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Logs}" 
                         Background="#0F172A" 
                         BorderThickness="0"
                         Padding="12,12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="»" Foreground="#3B82F6" FontWeight="Bold" Margin="0,0,8,0" FontSize="12" VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
