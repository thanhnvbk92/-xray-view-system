<UserControl x:Class="XrayCollector.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:XrayCollector.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1000">
    
    <Grid Margin="16,12,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel IsEnabled="{Binding IsSettingsEditable}">
                <!-- Warning Banner when Monitoring is Running -->
                <materialDesign:Card Visibility="{Binding IsMonitoringRunning, Converter={StaticResource BoolVisConverter}}"
                                     Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Padding="12" Margin="0,0,0,16" UniformCornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Foreground="#EF4444" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Hệ thống đang GIÁM SÁT (START). Vui lòng DỪNG (STOP) tại Trang chủ trước khi thay đổi cài đặt!" 
                                   Foreground="#991B1B" FontWeight="Bold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- API Configuration -->
                <TextBlock Text="KẾT NỐI MÁY CHỦ" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,12"/>
                <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="12" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ĐỊA CHỈ API (URL)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TempServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     MinHeight="48" FontSize="13" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" Padding="12,10"
                                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" 
                                     Style="{StaticResource MaterialDesignRaisedButton}"
                                     Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0"
                                     Width="48" Height="48" Padding="0"
                                     materialDesign:ButtonAssist.CornerRadius="8"
                                     Command="{Binding LoadDataCommand}"
                                     IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}">
                                <Grid>
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}}"/>
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="18" Height="18" Visibility="{Binding IsLoading, Converter={StaticResource BoolVisConverter}}"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Device Identity -->
                <TextBlock Text="ĐỊNH DANH THIẾT BỊ" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,12"/>
                <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="12" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="DÂY CHUYỀN SẢN XUẤT" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Lines}"
                                  SelectedItem="{Binding SelectedLine}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  MinHeight="48" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16"
                                  VerticalContentAlignment="Center"/>
                        <TextBlock Text="MÁY QUÉT X-RAY" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding FilteredMachines}"
                                  SelectedItem="{Binding SelectedMachine}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  MinHeight="48" FontSize="13" FontWeight="SemiBold"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Barcode Configuration -->
                <TextBlock Text="CẤU HÌNH BARCODE &amp; CỔNG COM" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,12"/>
                <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="12" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <!-- Scanner & Upstream Log Section (Chỉ áp dụng cho máy X-ray 9020) -->
                        <StackPanel Visibility="{Binding IsMachine9020, Converter={StaticResource BoolVisConverter}}">
                            <CheckBox Content="SỬ DỤNG MÁY QUÉT BARCODE (SCANNER)" 
                                      IsChecked="{Binding TempHasScanner}" 
                                      Margin="0,0,0,14" 
                                      FontSize="12" FontWeight="Bold"/>

                            <!-- Upstream Log & COM Port Section (Shown when HasScanner is False) -->
                            <StackPanel Visibility="{Binding TempHasScanner, Converter={StaticResource InverseBoolVisConverter}}" Margin="0,0,0,14">
                                <TextBlock Text="THƯ MỤC LOG MÁY TRƯỚC (ĐỌC PID TỪ MÁY TRƯỚC)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TempUpstreamLogPath}" IsReadOnly="True" 
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                             MinHeight="44" FontSize="11" VerticalContentAlignment="Center" Padding="12,8"/>
                                    <Button Grid.Column="1" Command="{Binding SelectFolderCommand}" CommandParameter="upstreamlog" 
                                            Margin="8,0,0,0" Style="{StaticResource MaterialDesignIconButton}" 
                                            Width="44" Height="44" Background="#F8FAFC">
                                        <materialDesign:PackIcon Kind="Folder" Foreground="#64748B" Width="18" Height="18"/>
                                    </Button>
                                </Grid>

                                <!-- Serial Port / COM Port Configuration for X-ray -->
                                <TextBlock Text="CỔNG COM KẾT NỐI MÁY X-RAY (SERIAL PORT)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Select COM Port -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="CỔNG COM" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableComPorts}"
                                                  SelectedItem="{Binding TempComPort}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  MinHeight="44" FontSize="12" FontWeight="SemiBold"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Select Baud Rate -->
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="BAUD RATE" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableBaudRates}"
                                                  SelectedItem="{Binding TempBaudRate}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  MinHeight="44" FontSize="12" FontWeight="SemiBold"
                                                  VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Refresh Ports Button -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button Command="{Binding RefreshComPortsCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="#F8FAFC" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                                                Height="44" Padding="12,0"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                ToolTip="Tải lại danh sách cổng COM">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Làm mới" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="CHẾ ĐỘ MAPPING BARCODE (PID)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Tăng dần (+)" 
                                         IsChecked="{Binding TempIsPidMappingIncrease}" 
                                         Margin="0,0,24,0" 
                                         FontSize="13" FontWeight="SemiBold"/>
                            <RadioButton Content="Giảm dần (-)" 
                                         IsChecked="{Binding TempIsPidMappingIncrease, Converter={StaticResource InverseBooleanConverter}}" 
                                         FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <CheckBox Content="BẬT MANUAL MAPPING THEO MODEL (CHỈ X-RAY 9020)"
                                  IsChecked="{Binding TempIsManualPidMappingEnabled}"
                                  Visibility="Collapsed"
                                  Margin="0,14,0,0"
                                  FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detected9020Model, StringFormat='JobFile/Model vừa đọc: {0}'}"
                                   Visibility="Collapsed"
                                   Margin="0,6,0,0" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </materialDesign:Card>


                <!-- Manual PID Mapping Configuration (Only for 9020) -->
                <TextBlock Text="MAPPING PID THỦ CÔNG (CHỈ CHO MÁY 9020)" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,12"
                           Visibility="Collapsed"/>
                <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="12" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1"
                                     Visibility="Collapsed">
                    <StackPanel>
                        <!-- Model Selection & Quick Add -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Select Model -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CHỌN MODEL CẤU HÌNH" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding TempModelMappings}"
                                          SelectedItem="{Binding SelectedModelMapping}"
                                          DisplayMemberPath="ModelName"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          MinHeight="48" FontSize="13" FontWeight="SemiBold"
                                          VerticalContentAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Add Model TextBox & Button -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" Width="220">
                                <TextBlock Text="TÊN MODEL MỚI" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48" FontSize="13" FontWeight="SemiBold"
                                             VerticalContentAlignment="Center" Padding="12,10"/>
                                    <Button Grid.Column="1" Command="{Binding AddModelCommand}"
                                            Margin="8,0,0,0" Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" Height="48" Width="48" Padding="0"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Delete Button -->
                            <Button Grid.Column="2" Command="{Binding DeleteModelCommand}"
                                    Margin="12,17,0,0" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#FEF2F2" Foreground="#DC2626" BorderThickness="0" Height="48"
                                    materialDesign:ButtonAssist.CornerRadius="8" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,4,0"/>
                                    <TextBlock Text="Xóa Model" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Config details for selected model -->
                        <StackPanel Visibility="{Binding HasSelectedModelMapping, Converter={StaticResource BoolVisConverter}}">
                            <Separator Background="#F1F5F9" Margin="0,0,0,16"/>
                            
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SỐ LƯỢNG UNIT CỦA BOARD" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding TempUnitCount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             MinHeight="48" FontSize="13" FontWeight="SemiBold"
                                             VerticalContentAlignment="Center" Padding="12,10"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="CẤU HÌNH CHI TIẾT MAPPING (UNIT -> BARCODE INDEX)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                            
                            <!-- Custom grid list for mappings -->
                            <ItemsControl ItemsSource="{Binding CurrentUnitMappings}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="{Binding UnitIndex, StringFormat='Unit {0}'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <materialDesign:PackIcon Grid.Column="1" Kind="ArrowRight" Width="16" Height="16" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <ComboBox Grid.Column="2" SelectedItem="{Binding PidIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.AvailablePidIndices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      Height="40" FontSize="13" FontWeight="SemiBold"
                                                      VerticalContentAlignment="Center">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='PID dòng {0} trong Log'}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Data Storage -->
                <TextBlock Text="CẤU HÌNH ĐƯỜNG DẪN" FontSize="10" FontWeight="Black" Foreground="#64748B" Margin="0,0,0,12"/>
                <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="12" Background="White" materialDesign:ElevationAssist.Elevation="Dp0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <!-- Main Log Section -->
                        <TextBlock Text="ĐƯỜNG DẪN LOG CHÍNH &amp; ĐỊNH DẠNG" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TempLogPath}" IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" VerticalContentAlignment="Center" Padding="12,8"/>
                            <TextBox Grid.Column="1" Text="{Binding TempLogExtension}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" Margin="8,0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,8"/>
                            <Button Grid.Column="2" Command="{Binding SelectFolderCommand}" CommandParameter="log" 
                                    Style="{StaticResource MaterialDesignIconButton}" Width="44" Height="44" Background="#F8FAFC">
                                <materialDesign:PackIcon Kind="File" Foreground="#64748B" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <!-- Sub Log Section -->
                        <TextBlock Text="ĐƯỜNG DẪN SUB LOG &amp; ĐỊNH DẠNG" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TempSubLogPath}" IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" VerticalContentAlignment="Center" Padding="12,8"/>
                            <TextBox Grid.Column="1" Text="{Binding TempSubLogExtension}" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" Margin="8,0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0,8"/>
                            <Button Grid.Column="2" Command="{Binding SelectFolderCommand}" CommandParameter="sublog" 
                                    Style="{StaticResource MaterialDesignIconButton}" Width="44" Height="44" Background="#F8FAFC">
                                <materialDesign:PackIcon Kind="File" Foreground="#64748B" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="THƯ MỤC HÌNH ẢNH (IMAGE)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TempImagePath}" IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" VerticalContentAlignment="Center" Padding="12,8"/>
                            <Button Grid.Column="1" Command="{Binding SelectFolderCommand}" CommandParameter="img" 
                                    Margin="8,0,0,0" Style="{StaticResource MaterialDesignIconButton}" 
                                    Width="44" Height="44" Background="#F8FAFC">
                                <materialDesign:PackIcon Kind="Folder" Foreground="#64748B" Width="18" Height="18"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="THƯ MỤC SAO LƯU (BACKUP)" FontSize="9" FontWeight="Black" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TempBackupPath}" IsReadOnly="True" 
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     MinHeight="44" FontSize="11" VerticalContentAlignment="Center" Padding="12,8"/>
                            <Button Grid.Column="1" Command="{Binding SelectFolderCommand}" CommandParameter="backup" 
                                    Margin="8,0,0,0" Style="{StaticResource MaterialDesignIconButton}" 
                                    Width="44" Height="44" Background="#F8FAFC">
                                <materialDesign:PackIcon Kind="Folder" Foreground="#64748B" Width="18" Height="18"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Action -->
        <Border Grid.Row="1" Background="White" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Button Command="{Binding SaveSettingsCommand}"
                    IsEnabled="{Binding IsSettingsEditable}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2563EB" Foreground="White"
                    Height="52" FontWeight="Black" FontSize="12"
                    materialDesign:ButtonAssist.CornerRadius="12"
                    materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,12,0" Width="20" Height="20" VerticalAlignment="Center"/>
                    <TextBlock Text="LƯU CẤU HÌNH" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
    </Grid>
</UserControl>
